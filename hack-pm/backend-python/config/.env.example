# GitHub Template System - Environment Variables

# Template Parsing Configuration
TEMPLATE_MAX_TEXT_LENGTH=10000
TEMPLATE_MAX_LIST_ITEMS=100
TEMPLATE_ENABLE_CACHING=true
TEMPLATE_STRICT_YAML=false
TEMPLATE_SANITIZATION=true

# Status Mapping Configuration
STATUS_ENABLE_TIME_BOXING=true
STATUS_ENABLE_HACKATHON=true
STATUS_DEFAULT_PRIORITY=medium
STATUS_ESCALATION_THRESHOLD=2.0

# Branch Naming Configuration
BRANCH_ENFORCE_CONVENTION=true
BRANCH_MAX_DESC_LENGTH=50
BRANCH_MIN_DESC_LENGTH=3
BRANCH_REQUIRE_ISSUE_NUMBER=true

# Global Settings
DEBUG_MODE=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=sqlite:///./hackathon.db

# GitHub API Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here